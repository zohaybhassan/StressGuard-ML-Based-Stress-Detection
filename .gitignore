# Gradle / Android build outputs
.gradle/
.kotlin/
build/
*/build/
captures/
.externalNativeBuild/
.cxx/

# Local machine configuration
local.properties
*.local

# Android Studio / IntelliJ.
# The whole directory rather than a list of individual files. It was removed from this
# repository deliberately, and Android Studio keeps generating new files in it (vcs.xml,
# AndroidProjectSystem.xml and so on) that a per-file list never anticipates, so they creep
# back one at a time.
*.iml
.idea/
.vscode/

# Generated APK / bundle artifacts
*.apk
*.ap_
*.aab
*.aar
*.dex

# Signing and secrets
*.jks
*.keystore
keystore.properties
app/google-services.json
.env
.env.*
!.env.example

# Supabase CLI scratch. The migrations themselves are schema definitions and MUST stay
# tracked: they carry no secrets, and versioning them is what makes the database
# reproducible. Only the CLI's local state is ignored here.
#
# config.toml is deliberately NOT ignored, despite an earlier rule here that did so. It is shared
# project configuration rather than local state -- it decides how `supabase db push` and
# `functions deploy` behave -- and it holds no secrets. Ignoring it meant every team member got
# whatever defaults their own `supabase init` produced.
supabase/.temp/
supabase/.branches/

# Logs and reports
*.log
logcat*.txt
hs_err_pid*
lint-results*.html
lint-results*.xml

# Test outputs
test-results/
connected_android_test_additional_output/

# OS files
.DS_Store
Thumbs.db

# Temporary project inspection files
tmp_model_inspect/

# ML training scratch output. CatBoost and MLflow write these into the working directory,
# so they appear at the repo root when a training script is run from here.
catboost_info/
mlruns/
__pycache__/
*.joblib

# Keep source model assets tracked.
!app/src/main/assets/stress_model/*.onnx
!app/src/main/assets/stress_model/*.json

