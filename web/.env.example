# Safe public values. Use the same Supabase project as the Android application.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Canonical browser origin used for Supabase email and OAuth redirects.
# Vercel previews fall back to VERCEL_URL automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AWS report generation is added in the History/reporting phase.
AWS_REGION=replace_me
AWS_REPORT_FUNCTION_NAME=replace_me
AWS_REPORTS_BUCKET=replace_me
