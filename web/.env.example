# Safe public values. Use the same Supabase project as the Android application.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Canonical browser origin used for Supabase email and OAuth redirects.
# Vercel previews fall back to VERCEL_URL automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only AWS report invocation. The S3 bucket name is provisioned and
# injected into Lambda by SAM; it does not belong in the browser/Vercel app.
AWS_REGION=replace_me
AWS_REPORT_FUNCTION_NAME=replace_me
# Optional published Lambda version or alias.
AWS_REPORT_FUNCTION_QUALIFIER=

# A random server-only value of at least 32 characters, unique per environment.
REPORT_RATE_LIMIT_SALT=replace_with_a_long_random_server_only_secret

# Supply AWS credentials through Vercel server-only environment variables or a
# workload identity integration. Never prefix AWS credentials with NEXT_PUBLIC_.
