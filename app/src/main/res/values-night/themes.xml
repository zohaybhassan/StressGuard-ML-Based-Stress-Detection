<?xml version="1.0" encoding="utf-8"?>
<!--
    Dark theme.

    Only what a palette swap cannot express lives here: the status bar icons have to flip to light,
    and that is a boolean rather than a colour. Everything else in values/themes.xml already
    resolves through colour resources that values-night/colors.xml redefines.

    Note this overrides Theme.StressGuard and *not* Base.Theme.StressGuard. Styles do not merge
    across resource qualifiers — they replace — so redefining the base here would silently drop
    every widget style the app has at night.
-->
<resources>
    <style name="Theme.StressGuard" parent="Base.Theme.StressGuard">
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
