<?xml version="1.0" encoding="utf-8"?>
<!-- A hairline above the navigation bar. Drawn as a layer rather than as a View in each layout,
     so the three screens that carry the bar cannot end up with two of them having a divider. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/outline" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
        </shape>
    </item>
</layer-list>
