<?xml version="1.0" encoding="utf-8"?>
<!-- The app speaking on its own behalf: a crisis reply, or a stand-in when the network failed.
     Tinted differently from a model reply so the transcript never passes one off as the other. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/bubble_fallback" />
    <stroke
        android:width="@dimen/stroke_width"
        android:color="@color/warning" />
    <corners
        android:bottomLeftRadius="6dp"
        android:bottomRightRadius="20dp"
        android:topLeftRadius="20dp"
        android:topRightRadius="20dp" />
</shape>
