<?xml version="1.0" encoding="utf-8"?>
<!--
    The stress card. Dark in both themes on purpose: it is the one instrument on the screen, and a
    dark face is what lets the gauge colour carry the reading instead of competing with a white
    card behind it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/hero_end"
        android:startColor="@color/hero_start"
        android:type="linear" />
    <corners android:radius="@dimen/radius_lg" />
</shape>
