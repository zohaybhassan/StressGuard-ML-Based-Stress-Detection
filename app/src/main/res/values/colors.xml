<?xml version="1.0" encoding="utf-8"?>
<!--
    The palette, light theme.

    Every colour the app draws is named here and nowhere else. Layouts and Kotlin reference these
    names, never a literal, which is what makes the dark theme in values-night a straight
    substitution rather than a second design.

    Names describe a role, not a hue. `stress_high` stays the right name if the red is ever
    retuned; `red_500` would not be.
-->
<resources>

    <!-- Brand. A clinical teal: cool enough to read as medical, warm enough not to feel like a
         hospital form. Used for primary actions, selected navigation and the user's own words. -->
    <color name="brand">#087A61</color>
    <color name="brand_dark">#05614D</color>
    <color name="brand_soft">#D9F5EA</color>
    <color name="brand_softer">#EAF9F3</color>
    <color name="on_brand">#FFFFFF</color>
    <color name="launcher_background">#073F35</color>

    <!-- Surfaces. The canvas is a barely-green off-white so that white cards lift off it without
         needing shadows; the whole UI is drawn with borders rather than elevation. -->
    <color name="canvas">#F2F9F7</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_variant">#EAF4F1</color>
    <color name="surface_analytics">#F2F7FB</color>
    <color name="surface_analytics_raised">#FFFFFF</color>
    <color name="outline_analytics">#D3E2EC</color>
    <color name="outline">#D6E8E3</color>
    <color name="outline_strong">#A9CBC2</color>
    <color name="scrim">#66061512</color>

    <!-- Text. Three weights of emphasis and no more; a fourth always ends up being used at random. -->
    <color name="text_primary">#102521</color>
    <color name="text_secondary">#405D56</color>
    <color name="text_tertiary">#5B746E</color>
    <color name="text_on_dark">#FFFFFF</color>
    <color name="text_on_dark_muted">#9FC3BB</color>

    <!-- The daylight stress hero uses a quiet mint wash that is visibly distinct from the
         sea-glass canvas without competing with the gauge or scenic header. -->
    <color name="hero_start">#E7F6F1</color>
    <color name="hero_end">#D7EEE7</color>
    <color name="hero_track">#BADCD3</color>
    <color name="hero_divider">#ADD4CA</color>
    <color name="hero_foreground">#102521</color>
    <color name="hero_foreground_muted">#49665F</color>

    <color name="header_scrim_start">#FAFDFDFA</color>
    <color name="header_scrim_end">#12FFFFFF</color>

    <!-- Severity. The same four colours everywhere: gauge, risk level, chart bars, alerts. A user
         who learns them once should not have to relearn them on the trends screen. -->
    <color name="stress_low">#087A61</color>
    <color name="stress_moderate">#8A5500</color>
    <color name="stress_elevated">#A84416</color>
    <color name="stress_high">#C52E50</color>

    <!-- Per-metric accents, so heart rate is the same colour on the dashboard tile and the chart. -->
    <color name="metric_heart">#C83252</color>
    <color name="metric_heart_soft">#FDE8ED</color>
    <color name="metric_steps">#0B65B4</color>
    <color name="metric_steps_soft">#E5F1FC</color>
    <color name="metric_sleep">#7950CC</color>
    <color name="metric_sleep_soft">#EFE8FC</color>

    <!-- Status and feedback. -->
    <color name="danger">#C52E50</color>
    <color name="danger_soft">#FDE8ED</color>
    <color name="warning">#8A5500</color>
    <color name="warning_soft">#FFF3D6</color>
    <color name="success">#087A61</color>
    <color name="neutral_soft">#EAF4F1</color>

    <!-- Chat. The user speaks in brand colour, the assistant on a plain card, and anything the app
         said on its own behalf (a crisis reply, a network fallback) sits on amber so the transcript
         never passes it off as the model's. -->
    <color name="bubble_user">#0A8C70</color>
    <color name="bubble_user_text">#FFFFFF</color>
    <color name="bubble_assistant">#FFFFFF</color>
    <color name="bubble_assistant_text">#102521</color>
    <color name="bubble_fallback">#FFF3D6</color>
    <color name="bubble_fallback_text">#684400</color>

    <!-- Charts. Separated from the metric accents because a chart needs a grid and axis colour
         that no card ever uses. -->
    <color name="chart_grid">#D5E5E1</color>
    <color name="chart_axis_text">#536F68</color>

    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
</resources>
