<?xml version="1.0" encoding="utf-8"?>
<!--
    The health checklist behind the checkup recommendation.

    Two cards, conditions and habits, because the two are answered differently: one is what a
    doctor has told you, the other is what you know about yourself. Grouping them makes a
    ten-checkbox screen read as two short questions instead of one long interrogation.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/checklistRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/space_2xl"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_xl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/checklist_title"
            android:textAppearance="@style/TextAppearance.StressGuard.Headline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/checklist_subtitle"
            android:textAppearance="@style/TextAppearance.StressGuard.Body" />

        <TextView
            style="@style/Widget.StressGuard.SectionLabel"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/checklist_section_conditions" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_md"
                android:paddingTop="@dimen/space_sm"
                android:paddingEnd="@dimen/space_md"
                android:paddingBottom="@dimen/space_sm">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbHeartCondition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/checklist_heart" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbHypertension"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/checklist_hypertension" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbDiabetes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/checklist_diabetes" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbSleepDisorder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/checklist_sleep" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbAnxietyHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/checklist_anxiety" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Widget.StressGuard.SectionLabel"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/checklist_section_habits" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_md"
                android:paddingTop="@dimen/space_sm"
                android:paddingEnd="@dimen/space_md"
                android:paddingBottom="@dimen/space_sm">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbSmoking"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/checklist_smoking" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbHighCaffeineUse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/checklist_caffeine" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbPhysicallyInactive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/checklist_inactive" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Plan §7 and §25: the app suggests a checkup, it does not diagnose. The line travels
             with the questions as well as with the answer. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginTop="1dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_info"
                app:tint="@color/text_tertiary" />

            <TextView
                android:id="@+id/tvChecklistDisclaimer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:text="@string/checklist_disclaimer"
                android:textAppearance="@style/TextAppearance.StressGuard.Footnote" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveChecklist"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/action_save_continue" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkipChecklist"
            style="@style/Widget.StressGuard.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_sm"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/checklist_skip" />
    </LinearLayout>
</ScrollView>
