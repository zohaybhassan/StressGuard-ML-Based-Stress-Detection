<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F3">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="#F4F7F3"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Trends"
        app:titleCentered="false"
        app:titleTextColor="#101816" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topAppBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="24dp">

            <!-- Today, as a headline. A live count rather than a rollup: a day that has not yet
                 reached the high-stress threshold still has readings worth showing. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeColor="#E0E7E2"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="TODAY"
                        android:textColor="#8A948F"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTodayHighStress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="--"
                        android:textColor="#101816"
                        android:textSize="34sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTodaySummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#64706A"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvWeekSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="#5F6B76"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Shown instead of the charts when there is nothing, or too little, to draw. With
                 passive collection a gap is normal, so this is a routine state rather than an
                 error. -->
            <TextView
                android:id="@+id/tvTrendsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:textColor="#64706A"
                android:textSize="15sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/chartGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TrendsSectionHeader"
                    android:text="HIGH-STRESS READINGS" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/TrendsChartCard">

                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/chartStress"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:padding="10dp" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/TrendsSectionHeader"
                    android:text="HEART RATE AND SLEEP" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/TrendsChartCard">

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chartVitals"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:padding="10dp" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/TrendsSectionHeader"
                    android:text="ACTIVITY LEVEL" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/TrendsChartCard">

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chartActivity"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:padding="10dp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- The vitals charts show what the model was actually fed, so the caveat about
                     what it can do with those numbers belongs beside them. -->
                <TextView
                    android:id="@+id/tvTrendsFootnote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Averages per day, from the readings your watch sent. Activity level is the figure given to the model, which is your best known full-day step count rather than the partial count so far today."
                    android:textColor="#8A948F"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:itemIconTint="#59635E"
        app:itemTextColor="#59635E"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />
</androidx.constraintlayout.widget.ConstraintLayout>
