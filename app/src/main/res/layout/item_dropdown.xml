<?xml version="1.0" encoding="utf-8"?>
<!--
    One row of an exposed dropdown.

    Replaces android.R.layout.simple_dropdown_item_1line, which draws with the platform's own
    colours rather than the app's: on the dark theme that was dark text on a dark sheet.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:paddingStart="@dimen/space_lg"
    android:paddingEnd="@dimen/space_lg"
    android:textColor="@color/text_primary"
    android:textSize="15sp" />
